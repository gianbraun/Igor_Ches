<UserControl x:Class="IGOR.Display.ControlPanel.Views.ControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:prism="http://prismlibrary.com/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:IGOR.Common.WPF.Controls;assembly=IGOR.Common.WPF"
             xmlns:local="clr-namespace:IGOR.Display.ControlPanel.Views" 
             xmlns:viewmodels="clr-namespace:IGOR.Display.ControlPanel.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ControlPanelViewModel}"
             mc:Ignorable="d" 
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary >
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IGOR.Display.ControlPanel;component/Styles/ControlPanelStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource AcentBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Margin="15,0">

            <core:ControlButton State="{Binding ControlOffState}"
                                Foreground="White"
                                Content="Steuerung Aus"
                                ButtonColor="{StaticResource ErrorBrush}"
                                PressedChangedCommand="{Binding ControlOffPressedCommand}"/>

            <core:ControlButton State="{Binding ControlOnState}"
                                Content="Steuerung Ein"
                                ButtonColor="{StaticResource ActiveBrush}"
                                PressedChangedCommand="{Binding ControlOnPressedCommand}"/>

            <core:ControlButton State="{Binding AutomaticOffState}"
                                Content="Automatik Aus"
                                ButtonColor="{StaticResource ErrorBrush}"
                                PressedChangedCommand="{Binding AutomaticOffPressedCommand}"/>

            <core:ControlButton State="{Binding AutomaticOnState}"
                                Content="Automatik Ein"
                                ButtonColor="{StaticResource ActiveBrush}"
                                PressedChangedCommand="{Binding AutomaticOnPressedCommand}"/>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="15,0">
            <core:ControlButton State="{Binding AcknowledgeState}"
                                Content="Quittieren"
                                ButtonColor="{StaticResource WarningBrush}"
                                PressedChangedCommand="{Binding AcknowledgeOnPressedCommand}"/>
        </StackPanel>
        
    </Grid>
</UserControl>
