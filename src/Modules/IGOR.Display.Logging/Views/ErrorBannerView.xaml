<UserControl x:Class="IGOR.Display.Logging.Views.ErrorBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IGOR.Display.Logging.Views" 
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:viewmodels="clr-namespace:IGOR.Display.Logging.ViewModels" 
             xmlns:comConv="clr-namespace:IGOR.Common.WPF.Converters;assembly=IGOR.Common.WPF"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=viewmodels:ErrorBannerViewModel}"
             xmlns:conv="clr-namespace:IGOR.Common.WPF.Converters;assembly=IGOR.Common.WPF"
             mc:Ignorable="d" 
             HorizontalAlignment="Center"
             x:Name="ErrorBanner"
             VerticalAlignment="Center">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/IGOR.Common.WPF;component/Styles/DefaultStyle.xaml"/>
    </UserControl.Resources>
    <Border CornerRadius="5"
            Background="{StaticResource ForegroundLightBrush}"
            x:Name="OuterBorder"
            Margin="0,0">
        <Border.Clip>
            <MultiBinding Converter="{comConv:BorderClipConverter}">
                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/>
            </MultiBinding>
        </Border.Clip>
        <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseLeftButtonUp">
                <i:InvokeCommandAction Command="{Binding OpenErrorListCommand}"/>
            </i:EventTrigger>
        </i:Interaction.Triggers>
        <Border.RenderTransform>
            <TranslateTransform X="0" Y="-100"/>
        </Border.RenderTransform>
        <Grid Height="60"
              MinWidth="650">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/> 
                <ColumnDefinition Width="auto"/> 
                <ColumnDefinition Width="*"/> 
                <ColumnDefinition Width="auto"/> 
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{Binding LogLevel, Converter={conv:LogEventLevelToSolidBrushConverter}, FallbackValue={StaticResource InformationBrush}, Mode=OneWay}"
                    Width="70">

                <Image Source="{Binding LogLevel, Converter={conv:LogEventLevelToIconConverter}, FallbackValue={StaticResource Information}, Mode=OneWay}"
                   Height="40"/>

            </Border>

            <TextBlock Grid.Column="1"
                       Text="{Binding Message, FallbackValue='A Long Error Message can fit here without problem'}"
                       Foreground="{StaticResource ForegroundDarkBrush}"
                       VerticalAlignment="Center"
                       Margin="20,0"
                       FontSize="14"/>

            <Button Grid.Column="3"
                    Margin="15,0,0,0"
                    Command="{Binding HideBannerCommand}"
                    Width="60"
                    FontSize="18"
                    FontFamily="Segoe UI"
                    Content="X"/>

        </Grid>

        <Border.Style>
            <Style>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Show}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation From="-100"
                                                 To="0"
                                                 Duration="0:0:0.25"
                                                 Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation From="0"
                                                 To="-100"
                                                 Duration="0:0:0.25"
                                                 Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
    
    <UserControl.Effect>
        <DropShadowEffect Opacity="0.5" BlurRadius="5" ShadowDepth="3"/>
    </UserControl.Effect>
    
</UserControl>
