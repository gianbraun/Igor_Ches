<UserControl x:Class="IGOR.Display.Parameters.Views.ParameterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IGOR.Display.Parameters.Views"
             xmlns:params ="clr-namespace:IGOR.Interface.Parameters;assembly=IGOR.Interface.Parameters"
             xmlns:conv ="clr-namespace:IGOR.Common.WPF.Converters;assembly=IGOR.Common.WPF"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             xmlns:viewmodels="clr-namespace:IGOR.Display.Parameters.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ParameterViewModel}"
             xmlns:prism="http://prismlibrary.com/" 
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/IGOR.Display.Parameters;component/Styles/MainStyle.xaml"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource SecondaryBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <TreeView Margin="10" Background="{StaticResource MainBrush}"
                  ItemsSource="{Binding ParameterGroups}"
                  x:Name="TreeView">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectedItemChanged">
                    <i:InvokeCommandAction Command="{Binding SelectedItemChangedCommand}"
                                           CommandParameter="{Binding ElementName=TreeView, Path= SelectedItem }"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type params:ParameterGroup}" ItemsSource="{Binding Path=SubGroups}">
                    <TextBlock Text="{Binding Name}"/>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
            <TreeView.Effect>
                <DropShadowEffect Opacity="0.2"/>
            </TreeView.Effect>
        </TreeView>

        <Grid Grid.Column="1"
              Margin="0,10,10,10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10" Background="{StaticResource MainBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding ElementName=TreeView, Path=SelectedItem.Name}"
                           FontSize="16pt"
                           Foreground="{StaticResource ForegroundDarkBrush}"
                           Padding="15"/>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="2">

                    <Button Command="{Binding EditParameterCommand}"
                            IsEnabled="{Binding IsParameterSelected}">
                        <Image Source="{StaticResource EditDrawingImage}"/>
                    </Button>

                    <Button Command="{Binding SaveParametersCommand}"  
                            BorderBrush="{Binding OutDated, Converter={conv:BoolToWarningColorConverter}, Mode=OneWay}"
                            IsEnabled="{Binding OutDated}">
                        <Image Source="{StaticResource SaveDrawingImage}"/>
                    </Button>

                </StackPanel>
                
                
            </Grid>
            <Border Grid.Row="1"
                    Background="{StaticResource MainBrush}">
                <DataGrid ItemsSource="{Binding SelectedParameters}"
                          Margin="10"
                          TargetUpdated="DataGrid_TargetUpdated"
                          SelectedItem="{Binding SelectedDataGridParameter}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bezeichnung" 
                                            Binding="{Binding Name}" 
                                            Width="*"/>

                        <DataGridTextColumn Header="Gespeichert" 
                                            Binding="{Binding Value, NotifyOnTargetUpdated=True}" 
                                            ElementStyle="{DynamicResource CenteredText}"
                                            Width="auto"/>

                        <DataGridTextColumn Header="Online" 
                                            Binding="{Binding OnlineValue, NotifyOnTargetUpdated=True}"
                                            ElementStyle="{DynamicResource CenteredText}"
                                            Width="auto"/>

                        <DataGridTextColumn Header="Min" 
                                            Binding="{Binding Min, NotifyOnTargetUpdated=True}" 
                                            Width="auto"
                                            ElementStyle="{DynamicResource CenteredText}"/>

                        <DataGridTextColumn Header="Max" 
                                            Binding="{Binding Max, NotifyOnTargetUpdated=True}" 
                                            Width="auto"
                                            ElementStyle="{DynamicResource CenteredText}"/>

                        <DataGridTextColumn Header="Einheit" 
                                            Binding="{Binding Unit, NotifyOnTargetUpdated=True}" 
                                            Width="auto"
                                            ElementStyle="{DynamicResource CenteredText}"/>
                        
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Grid.Effect>
                <DropShadowEffect Opacity="0.2"/>
            </Grid.Effect>
        </Grid>

    </Grid>
</UserControl>
