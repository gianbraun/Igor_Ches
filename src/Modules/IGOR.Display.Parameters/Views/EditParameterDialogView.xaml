<UserControl x:Class="IGOR.Display.Parameters.Views.EditParameterDialogView"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/" xmlns:viewmodels="clr-namespace:IGOR.Display.Parameters.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:EditParameterDialogViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"  
             mc:Ignorable="d" 
             x:Name="Control"
             d:Height="275"
             d:Width="450">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="Height" Value="275"/>
            <Setter Property="MinWidth" Value="450"/>
            <Setter Property="SizeToContent" Value="Width"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary  Source="pack://application:,,,/IGOR.Common.WPF;component/Styles/DefaultStyle.xaml"/>
                <ResourceDictionary>
                    <Style TargetType="TextBox" x:Key="InputTextBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=Control, Path=DataContext.IsValid}" Value="false">
                                <Setter Property="BorderBrush" Value="Red"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderThickness="2"
            BorderBrush="{StaticResource ForegroundDarkBrush}">
        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Title}"
                   Padding="10"
                   FontFamily="Segoe ui light"
                   Foreground="{StaticResource ForegroundLightBrush}"
                   Background="{StaticResource AcentBrush}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   TextAlignment="Center"
                   FontSize="16pt"/>

            <Grid Grid.Row="1" 
              Margin="15"
              VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Wert:"
                               FontSize="16"/>
                    <TextBox Text="{Binding InputValue, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"
                             FontSize="16"/>
                    <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="Red"
                           FontSize="11"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                <Button Content="Ok"
                        Margin="10"
                        Width="90"
                        FontSize="16"
                        Background="{StaticResource AcentBrush}"
                        BorderThickness="0"
                        IsEnabled="{Binding IsValid}"
                        Foreground="{StaticResource ForegroundLightBrush}"
                        Command="{Binding CloseDialogCommand}"
                        CommandParameter="true"/>

                <Button Content="Abbrechen"
                    Margin="10"
                        FontSize="16"
                        Padding="5"
                        Width="90"
                        Background="{StaticResource AcentBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource ForegroundLightBrush}"
                        Command="{Binding CloseDialogCommand}"
                        CommandParameter="false"/>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
