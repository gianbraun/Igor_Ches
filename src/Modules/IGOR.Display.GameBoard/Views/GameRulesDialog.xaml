<UserControl x:Class="IGOR.Display.GameBoard.Views.GameRulesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IGOR.Display.GameBoard.Views"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:game="clr-namespace:IGOR.Interface.Game;assembly=IGOR.Interface.Game"
             xmlns:ext="clr-namespace:IGOR.Common.WPF.Extensions;assembly=IGOR.Common.WPF"
             xmlns:viewmodels="clr-namespace:IGOR.Display.GameBoard.ViewModels" 
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:GameRulesDialogViewModel}"
             d:Height="600"
             d:Width="850">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="Height" Value="600"/>
            <Setter Property="Width" Value="850"/>
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/IGOR.Common.WPF;component/Styles/DefaultStyle.xaml"/>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}"
                   Padding="10"
                   FontFamily="Segoe ui light"
                   Foreground="{StaticResource ForegroundLightBrush}"
                   Background="{StaticResource AcentBrush}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   TextAlignment="Center"
                   FontSize="16pt"/>

        <Grid Grid.Row="1" 
              Margin="10">
            <Grid.Resources>
                <ResourceDictionary>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="TextIndent" Value="2"/>
                    </Style>
                </ResourceDictionary>
            </Grid.Resources>
            <TextBlock VerticalAlignment="Stretch"
                       HorizontalAlignment="Stretch"
                       Text="{Binding Content}"/>


        </Grid>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    
                    Orientation="Horizontal">
            <Button Content="Ok"
                    Margin="10"
                    Width="75"
                    Command="{Binding CloseDialogCommand}"/>

            
        </StackPanel>
    </Grid>
</UserControl>
