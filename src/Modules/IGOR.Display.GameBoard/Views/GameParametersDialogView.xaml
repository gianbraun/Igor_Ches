<UserControl x:Class="IGOR.Display.GameBoard.Views.GameParametersDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IGOR.Display.GameBoard.Views"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:game="clr-namespace:IGOR.Interface.Game;assembly=IGOR.Interface.Game"
             xmlns:extensions="clr-namespace:IGOR.Common.WPF.MarkupExtensions;assembly=IGOR.Common.WPF" 
             xmlns:viewmodels="clr-namespace:IGOR.Display.GameBoard.ViewModels" 
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:GameParametersDialogViewModel}"
             d:Height="275"
             d:Width="450">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="Height" Value="275"/>
            <Setter Property="Width" Value="450"/>
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/IGOR.Common.WPF;component/Styles/DefaultStyle.xaml"/>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title, FallbackValue='Spiel zu Ende'}"
                   Padding="10"
                   FontFamily="Segoe ui light"
                   Foreground="{StaticResource ForegroundLightBrush}"
                   Background="{StaticResource AcentBrush}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   TextAlignment="Center"
                   FontSize="16pt"/>

        <Grid Grid.Row="1" 
              Margin="10"
              VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Message, FallbackValue='Herzlichen Glückwunsch du hast Gewonnen!!'}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="180"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       FontSize="18"/>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center">

                <StackPanel >
                    <TextBlock Text="Schwierigkeitsgrad:"/>
                    <ComboBox Width="150"
                          HorizontalAlignment="Left"
                          ItemsSource="{extensions:EnumToCollection EnumType={x:Type game:Difficulty}}"
                          SelectedIndex="{Binding DifficultyIndex}"/>
                </StackPanel>

                <StackPanel Margin="0,10">

                    <TextBlock Text="Spielsteinfarbe:"/>

                    <ComboBox Width="150"
                          x:Name="PlayerComboBox"
                          HorizontalAlignment="Left"
                          ItemsSource="{extensions:EnumToCollection EnumType={x:Type game:Player}}"
                          SelectedIndex="{Binding PlayerIndex}"/>

                </StackPanel>

                <StackPanel x:Name="PlayingBoardPanel">

                    <TextBlock Text="Spielfeld:"/>

                    <ComboBox Width="150"
                              HorizontalAlignment="Left"
                              x:Name="PlayingBoard"
                              ItemsSource="{Binding Game.Views.Keys}"
                              SelectedIndex="0"
                              SelectedItem="{Binding SelectedKey}"/>

                </StackPanel>

            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Content="{Binding OkButtonText, FallbackValue=Neustart}"
                    Margin="10"
                    Command="{Binding CloseDialogCommand}"
                    CommandParameter="true"/>

            <Button Content="{Binding CancleButtonText, FallbackValue=Beenden}"
                    Margin="10"
                    Foreground="{StaticResource ForegroundLightBrush}"
                    Command="{Binding CloseDialogCommand}"
                    CommandParameter="false"/>
        </StackPanel>
    </Grid>
</UserControl>
