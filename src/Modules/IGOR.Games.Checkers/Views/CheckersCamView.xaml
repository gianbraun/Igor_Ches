<UserControl x:Class="IGOR.Games.Checkers.Views.CheckersCamView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prims="http://prismlibrary.com/"
             xmlns:conv="clr-namespace:IGOR.Games.Checkers.Converter"
             xmlns:comConv="clr-namespace:IGOR.Common.WPF.Converters;assembly=IGOR.Common.WPF"
             xmlns:viewmodels="clr-namespace:IGOR.Games.Checkers.ViewModels"  
             d:DataContext="{d:DesignInstance Type=viewmodels:CheckersCamViewModel}"
             prims:ViewModelLocator.AutoWireViewModel="True"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             mc:Ignorable="d"
             x:Name="CheckersControl">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/IGOR.Common.WPF;component/Styles/DefaultStyle.xaml"/>
    </UserControl.Resources>


    <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">

        <!--Left Column-->
        <StackPanel MaxHeight="500">
            <Button Content="Trigger Kamera" HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="25"
                Command="{Binding TriggerCamCommand}"/>
            <Button Content="Bestätige Zug" HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="25"
                Command="{Binding ValidateMoveCommand}"/>
            <TextBlock HorizontalAlignment="Center"
                       Text="{Binding Message}" 
                       Foreground="Red"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" MinWidth="150">
                <TextBlock Margin="0,0,5,0">Du spielst:</TextBlock>
                <TextBlock Text="{Binding Game.HumanPlayer, Converter={conv:PlayerToStringConverter}, Mode=OneWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,5" HorizontalAlignment="Center" MinWidth="150">
                <TextBlock Text="{Binding Game.CurrentState.Self, Converter={conv:PlayerToStringConverter}, Mode=OneWay}"/>
                <TextBlock Margin="5,0,0,0">ist an der Reihe.</TextBlock>
            </StackPanel>
        </StackPanel>

        <!--Central Column-->
        <Grid Background="White">
            <Viewbox Height="500" RenderOptions.BitmapScalingMode="Fant">
                <Grid>
                    <!--Draw Board-->
                    <Canvas x:Name="DrawingCanvas"/>

                    <!--Draw Stones-->
                    <ItemsControl ItemsSource="{Binding Stones}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas x:Name="StoneCanvas"
                                    Width="{Binding ElementName=DrawingCanvas,Path=Width}"
                                    Height="{Binding ElementName=DrawingCanvas, Path=Height}">
                                </Canvas>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Ellipse Width="90"
                                     Height="90"
                                     StrokeThickness="2"
                                     Stroke="Gray"
                                     Fill="{Binding Player, Converter={conv:PlayerToColorConverter}, Mode=OneWay}"
                                     x:Name="Stone">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="-45" Y="-45"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse Width="90"
                                     Height="90"
                                     StrokeThickness="{Binding IsInvalidPos , Converter={comConv:BoolToThicknessConverter}, ConverterParameter=5}"
                                     Stroke="Red"
                                     Fill="Transparent"
                                     x:Name="StoneError">
                                        <Ellipse.Effect>
                                            <DropShadowEffect ShadowDepth="5" BlurRadius="10" Opacity="0.6"/>
                                        </Ellipse.Effect>
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="-45" Y="-45"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>

                    <!--Draw Differences-->
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Differences}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas x:Name="DifferencesCanvas"
                                    Width="{Binding ElementName=DrawingCanvas,Path=Width}"
                                    Height="{Binding ElementName=DrawingCanvas, Path=Height}">
                                    </Canvas>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding ElementName=CheckersControl, Path=Size}"
                                    Height="{Binding ElementName=CheckersControl, Path=Size}"
                                    BorderThickness="5"
                                    BorderBrush="Red" >
                                        <Border.RenderTransform>
                                            <TranslateTransform X="{Binding ElementName=CheckersControl, Path=DifferenceRenderTransform}" Y="{Binding ElementName=CheckersControl, Path=DifferenceRenderTransform}"/>
                                        </Border.RenderTransform>

                                        <Ellipse HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Width="100"
                                         Height="100"
                                         StrokeThickness="5"
                                         Stroke="Red"
                                         Fill="{Binding Player, Converter={conv:DifferencePlayerToColorConverter}, Mode=OneWay}"
                                         x:Name="Difference" Opacity="0.7">
                                        </Ellipse>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding FieldX}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding FieldY}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Grid>

                    <!--Draw Kings-->
                    <ItemsControl ItemsSource="{Binding Kings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas x:Name="KingsCanvas"
                                    Width="{Binding ElementName=DrawingCanvas,Path=Width}"
                                    Height="{Binding ElementName=DrawingCanvas, Path=Height}">
                                </Canvas>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Image   Width="60"
                                     Height="60"
                                     x:Name="King"
                                     Source="{StaticResource KingIcon}">
                                        <Image.RenderTransform>
                                            <TranslateTransform X="-30" Y="-30"/>
                                        </Image.RenderTransform>
                                    </Image>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>
            </Viewbox>

        </Grid>

        <!--Right Column-->
        <Button Content="Spielregeln"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="25"
                Command="{Binding OpenGameRulesCommand}"/>
    </StackPanel>

</UserControl>
