<UserControl x:Class="IGOR.Games.Checkers.Views.CheckersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:IGOR.Games.Checkers.Converter"
             xmlns:prism="http://prismlibrary.com/" xmlns:viewmodels="clr-namespace:IGOR.Games.Checkers.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:CheckersViewModel}"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/IGOR.Common.WPF;component/Styles/DefaultStyle.xaml"/>
    </UserControl.Resources>


    <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
        
        <!--Left Column-->
        <StackPanel MaxHeight="500">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" MinWidth="150">
                <TextBlock Margin="0,0,5,0">Du spielst:</TextBlock>
                <TextBlock Text="{Binding Game.HumanPlayer, Converter={conv:PlayerToStringConverter}, Mode=OneWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,5" HorizontalAlignment="Center" MinWidth="150">
                <TextBlock Text="{Binding Game.CurrentState.Self, Converter={conv:PlayerToStringConverter}, Mode=OneWay}"/>
                <TextBlock Margin="5,0,0,0">ist an der Reihe.</TextBlock>
            </StackPanel>
        </StackPanel>
        
        <!--Center Column-->
        <Viewbox Width="500"
             Height="500">
            <StackPanel x:Name="MainStackPanel"
                    Background="White"/>
        </Viewbox>
        
        <!--Right Column-->
        <Button Content="Spielregeln"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="25"
                Command="{Binding OpenGameRulesCommand}"/>
    </StackPanel>


</UserControl>
