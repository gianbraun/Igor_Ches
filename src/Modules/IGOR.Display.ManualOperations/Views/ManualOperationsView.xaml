<UserControl x:Class="IGOR.Display.ManualOperations.Views.ManualOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:prism="http://prismlibrary.com/" 
             xmlns:viewmodels="clr-namespace:IGOR.Display.ManualOperations.ViewModels" 
             xmlns:core="clr-namespace:IGOR.Common;assembly=IGOR.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ManualOperationsViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/IGOR.Display.ManualOperations;component/Styles/Styles.xaml"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="{StaticResource MainBrush}"
                    Margin="10,10,10,0">
            <Border BorderBrush="{StaticResource ForegroundDarkBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="Achsen"
                       FontSize="18"
                       Foreground="{StaticResource ForegroundDarkBrush}"
                       Margin="10"/>
            </Border>

            <ListView ItemsSource="{Binding Axes}"
                      ItemTemplate="{StaticResource AxisOverviewTemplate}"
                      SelectedItem="{Binding SelectedAxis}"
                      BorderThickness="0"/>
            <StackPanel.Effect>
                <DropShadowEffect Opacity="0.2"/>
            </StackPanel.Effect>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Background="{StaticResource MainBrush}"
                    Margin="10">
            <Border BorderBrush="{StaticResource ForegroundDarkBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="Aktoren"
                       FontSize="18"
                       Foreground="{StaticResource ForegroundDarkBrush}"
                       Margin="10"/>
            </Border>


            <ListView ItemsSource="{Binding Actors}"
                      ItemTemplate="{StaticResource ActorOverviewTemplate}"
                      SelectedItem="{Binding SelectedActor}"
                      BorderThickness="0"/>

            <StackPanel.Effect>
                <DropShadowEffect Opacity="0.2"/>

            </StackPanel.Effect>
        </StackPanel>

        <Grid Grid.Column="1"
              Grid.RowSpan="2"
              Margin="0,10,10,10"
              Background="{StaticResource MainBrush}">

            <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.DetailRegion}"/>
            <Grid.Effect>
                <DropShadowEffect Opacity="0.2"/>
            </Grid.Effect>
        </Grid>



    </Grid>
</UserControl>
