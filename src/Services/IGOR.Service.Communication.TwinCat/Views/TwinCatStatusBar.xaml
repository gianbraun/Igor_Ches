<UserControl x:Class="IGOR.Service.Communication.TwinCat.Views.TwinCatStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IGOR.Service.Communication.TwinCat.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             xmlns:prism="http://prismlibrary.com/" 
             xmlns:conv="clr-namespace:IGOR.Service.Communication.TwinCat.Converter"
             xmlns:viewmodels="clr-namespace:IGOR.Service.Communication.TwinCat.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:TwinCatStatusBarViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True" >
    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="20,10">
        <StackPanel>
            <Image Source="{Binding SysState, Converter={conv:PlcStateToIconConverter}}"
                   Width="40"
                   Height="40"/>
            <TextBlock Text="SYS"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"
                       FontSize="16"
                       Foreground="White"/>
            
        </StackPanel>
        <StackPanel Margin="15,0,0,0">
            <Image Source="{Binding PlcState, Converter={conv:PlcStateToIconConverter}}"
                   Width="40"
                   Height="40"
                   RenderOptions.BitmapScalingMode="Fant"/>
            <TextBlock Text="PLC"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"
                       FontSize="16"
                       Foreground="White"/>
        </StackPanel>
    </StackPanel>
</UserControl>
