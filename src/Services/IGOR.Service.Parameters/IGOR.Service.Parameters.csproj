<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
	<PropertyGroup>
		<TargetFramework>net5.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<AssemblyName>IGOR.Service.Parameters</AssemblyName>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
		<PackageReference Include="Prism.Core" Version="8.1.97" />
		<PackageReference Include="PropertyChanged.Fody" Version="3.4.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\Common\IGOR.Common\IGOR.Common.csproj" />
		<ProjectReference Include="..\..\Interfaces\IGOR.Interface.Communication\IGOR.Interface.Communication.csproj" />
		<ProjectReference Include="..\..\Interfaces\IGOR.Interface.Paramters\IGOR.Interface.Parameters.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ModuleFiles Include="$(TargetDir)*.dll" DestinationPath="$(SolutionDir)IGOR\bin\$(Configuration)\Modules\%(Filename)%(Extension)" />
		<DebugFiles Include="$(TargetDir)*.pdb" DestinationPath="$(SolutionDir)IGOR\bin\$(Configuration)\%(Filename)%(Extension)" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Inputs="@(ModuleFiles)" Outputs="@(ModuleFiles->'%(DestinationPath)')">
		<Copy SourceFiles="@(ModuleFiles)" DestinationFiles="@(ModuleFiles->'%(DestinationPath)')" />
		<Message Text="Modules Copied" />
	</Target>

	<Target Name="CopyDebugInfos" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Debug'" Inputs="@(DebugFiles)" Outputs="@(DebugFiles-&gt;%(DestinationPath))">
		<Copy SourceFiles="@(DebugFiles)" DestinationFiles="@(DebugFiles->'%(DestinationPath)')" />
		<Message Text="DebugFiles Copied" />
	</Target>

</Project>