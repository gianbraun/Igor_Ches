<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nav="clr-namespace:IGOR.Interface.Navigation;assembly=IGOR.Interface.Navigation"
                    xmlns:conv ="clr-namespace:IGOR.Common.WPF.Converters;assembly=IGOR.Common.WPF">

    
    <Style TargetType="Button" x:Key="NavigationButton">
        <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Margin" Value="10,10,10,0"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="70"/>
        <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="5"
                            x:Name="Border">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AcentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <DataTrigger Binding="{Binding Active}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AcentBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="NavigationButtonTemplate" DataType="{x:Type nav:INavigationButton}">
        <Button Style="{StaticResource NavigationButton}"
                Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}, Path=DataContext.NavigateCommand}"
                CommandParameter="{Binding}">
            <StackPanel>
                <Image Source="{Binding IconRessourceKey, Converter={conv:RessourceKeyToIconConverter}, Mode=OneWay}"
                       Width="40"
                       Height="40"
                       HorizontalAlignment="Center"
                       Margin="0,2"
                       RenderOptions.BitmapScalingMode="Fant"/>
                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Button>
    </DataTemplate>

</ResourceDictionary>