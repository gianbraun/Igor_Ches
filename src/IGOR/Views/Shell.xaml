<Window x:Class="IGOR.Views.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        xmlns:core="clr-namespace:IGOR.Common;assembly=IGOR.Common" 
        xmlns:viewmodels="clr-namespace:IGOR.ViewModels" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ShellViewModel}"
        Title="{Binding Title}" 
        Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        WindowState="Maximized">

    <DockPanel LastChildFill="True"
               Background="{StaticResource SecondaryBrush}">
        
        <Grid DockPanel.Dock="Top"
              Background="{StaticResource AcentBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="{StaticResource MechgamesLight}" 
                   Height="50"
                   RenderOptions.BitmapScalingMode="Fant"
                   Margin="10,0"/>

            <ContentControl Grid.Column="1"
                            prism:RegionManager.RegionName="{x:Static core:RegionNames.ErrorBanner}"/>

            <ContentControl Grid.Column="2"
                            prism:RegionManager.RegionName="{x:Static core:RegionNames.ErrorIndicator}"/>
            <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.PlcStatusBar}"
                            Grid.Column="3"/>
        </Grid>

        <ContentControl DockPanel.Dock="Bottom" prism:RegionManager.RegionName="{x:Static core:RegionNames.ControlPanelRegion}" Background="{StaticResource AcentBrush}"/>
        <ContentControl DockPanel.Dock="Left" prism:RegionManager.RegionName="{x:Static core:RegionNames.NavigationRegion}"/>
        

        <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.MainRegion}"/>
        
        
    </DockPanel>
        
</Window>
