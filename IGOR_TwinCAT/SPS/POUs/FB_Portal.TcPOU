<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Portal" Id="{18d1828e-5992-4277-8a1c-66c38aa89f04}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Portal
VAR_INPUT
	bManualMode:			BOOL;	                    	
	stNewJob:				ST_PortalJob;
	bImportJob:				BOOL;
	bQuit:					BOOL;
	bFuseOk:				BOOL;
	bFuse48VOk:				BOOL;
	bSafetyRun AT %Q*:		BOOL;
END_VAR
VAR CONSTANT	
END_VAR                 	
VAR_OUTPUT          		
	bBusy:					BOOL;
	fbError:				FB_Error;
	                    	
	//Safety            	
	bSafetyOK AT %I*:		BOOL := TRUE;
END_VAR             		
VAR                     
	//Safety            	
	bQuitEStop AT %Q*:		BOOL;
	bSafetyErrAck AT %Q*:	BOOL;
	
	//Sensor Stempeln		
	bStampZAxis				AT %I*	: BOOL;
	rTrigStamp:				R_TRIG;
	bStampReset: 			BOOL;
	
	fbRTrigSafety:			R_TRIG;
	                    	
	ePortalState:			E_PortalState_New;
	eTargetPortalState: 	E_PortalState_New;
	                    	
	fbGripper:				FB_Gripper := (bEnable := TRUE);
  
	aAxis:					ARRAY [X..Z] OF AXIS_REF;
	fbAxesEnable:			FB_AxesEnable;
	fbResetAxis:			MC_Reset; 
	                    	
	ipNcCtrl:				I_NC_Ctrl;
	fbNciCtrl:				FB_NciCtrl;
	                    	
	bMagazineTrack:			BOOL; //Anzahl steine in Magazinen bekannt? false wenn Spieler eingreift oder nicht initialisiert
	                    	
	stActJob:				ST_PortalJob;
	aJobBuffer:				ARRAY [0..MAX_JOB_COUNT - 1] OF ST_PortalJob;
	nJobCount:				USINT;
	i, k:					USINT;
	                    	
	aMagCounter:			ARRAY [0..MAGAZINE_NUMBER-1] OF USINT; //Anzahl Steine in Magazinen
	aMagSkipCheck:			ARRAY [0..MAGAZINE_NUMBER-1] OF BOOL;
	aMagYPositions:			ARRAY [0..MAGAZINE_NUMBER-1] OF LREAL; //Mitte Y
	aMagYScanPositions:		ARRAY [0..MAGAZINE_NUMBER-1] OF LREAL;
	fStonePosZFromMag:		LREAL; //berechnete Z pos für Stein aus Magazin
	nMag:					INT;
	nSelectedMag:			INT;
	nPosInMag:				USINT;
	bValidateStonePos:		BOOL;
	nValidationValue:		INT;
	bLastJobBlack:			BOOL;
	
//MAG Check
	nStonesInMag:				INT := MAGAZINE_CAPACITY;
	bWaitPortal, bCheck:		BOOL;
	bCheckedAllMag: 	BOOL;
	nNumChecked:				INT;
	rTrigCheck:			R_TRIG;
//New
	nCntActiveJobs		: SINT;
	nCntRemoveStones	: SINT;
	eCheckMagState		: E_CheckMagazines_New;
	nStonesInMagazin	: USINT := MAGAZINE_CAPACITY;
	
	bAllJobsReceived	: BOOL;
	
	nStateJobSelect		: INT;
	
	bReady				: BOOL;
	
	fTrigNCIDone		: F_TRIG;
	
	fSetJobHeight	: LREAL;
	
	bNCIJobStarted : BOOL;
	
	eSetJobState	: E_SetJobState;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF ipNcCtrl <> 0 THEN
	A_Cycle();
ELSIF ePortalState <> E_PortalState_INIT THEN
	fbError.M_Set(1, 'Interface nicht referenziert', ePortalState, E_ErrorIDs.eInvalidReference, E_ErrorSrcs.ePlc);
	RETURN;
END_IF
fTrigNCIDone(CLK := fbNciCtrl.P_Busy);

CASE ePortalState OF
	E_PortalState_New.eInit:
		A_Init();
		ePortalState := E_PortalState_New.eIdle;
		
	E_PortalState_New.eIdle:
		IF NOT bManualMode THEN
			IF aJobBuffer[0].nJobID <> 0 THEN
				fbAxesEnable.M_EnableAxes();
				IF fbGripper.bGripperOpen THEN
					IF HMI.bAllJobsSend THEN	
						nValidationValue := 0;	//TODO: entfernen wenn eSetJobState verwendet
						bReady := FALSE;
						nNumChecked := 0;		//TODO: entfernen wenn eSetJobState verwendet
						nStateJobSelect := 0;
						ePortalState := E_PortalState_New.eSetJob;
					END_IF
				ELSE
					eTargetPortalState := E_PortalState_New.eIdle;
					ePortalState := E_PortalState_New.eOpenGripper;
				END_IF
			END_IF
		ELSE	//Handbetrieb
			ipNcCtrl.P_Enable := FALSE;
			fbAxesEnable.M_EnableAxes();
			ePortalState := E_PortalState_New.eManualMode;
		END_IF
	
	E_PortalState_New.eOpenGripper:
		fbGripper(bEnable := TRUE, bOpen := TRUE, bClose := FALSE);
		IF NOT fbGripper.bBusy AND fbGripper.bGripperOpen THEN
			IF eTargetPortalState = E_PortalState_New.eIdle THEN
				fbGripper(bOpen := FALSE);
				ePortalState := eTargetPortalState;	
			ELSE
				IF NOT fbGripper.fbError.bError THEN
					IF stActJob.nJobID <> 0 THEN	//aktuellen Auftrag umgesetzt
						IF stActJob.eJobType = E_JobType.E_JobType_RemoveStone AND nCntActiveJobs = 1 THEN
							aMagCounter[nSelectedMag] := aMagCounter[nSelectedMag] + nCntRemoveStones;
							nCntRemoveStones := 0;
						END_IF
						nCntActiveJobs := nCntActiveJobs - 1;
						HMI.stLastJob := stActJob;
						A_DequeueJob();
						IF nCntActiveJobs <= 0 THEN
							bReady := FALSE;
						END_IF
					ELSE
						bReady := FALSE;
					END_IF
					IF nJobCount = 0 THEN
						ipNcCtrl.M_NewJob(HMI.fPortalPosIdleX, HMI.fPortalPosIdleY, HMI.fPortalPosIdleZ); //Auftrag zu Home-Pos
						ePortalState := E_PortalState_New.eHome;
					ELSE
						ePortalState := E_PortalState_New.eSetJob;	
					END_IF			
				ELSE
					fbError := fbGripper.fbError;
					ePortalState := E_PortalState_New.eError;		
				END_IF
			END_IF
		END_IF
		
	E_PortalState_New.eSetJob:
		HMI.bAllJobsSend := FALSE;
		IF bReady THEN
			//Weiterer Auftrag in Auftragsreihenfolge
			IF nCntActiveJobs >= 1 AND aJobBuffer[0].eJobType = E_JobType.E_JobType_NewStone THEN 
				aJobBuffer[0].fStartPosX := stActJob.fDestPosX;
				aJobBuffer[0].fStartPosY := stActJob.fDestPosY;
				stActJob := aJobBuffer[0];
				
				eTargetPortalState := E_PortalState_New.eMoveToStone;
				ePortalState := E_PortalState_New.eDebug;
				fSetJobHeight := STONE_POS_FIELD_Z + STONE_HEIGHT;
				
				//ipNcCtrl.M_NewJob(stActJob.fStartPosX, stActJob.fStartPosY, STONE_POS_FIELD_Z + STONE_HEIGHT);
				//ePortalState := E_PortalState_New.eMoveToStone;
			//Weiterer Auftrag in Auftragsreihenfolge
			ELSIF nCntActiveJobs >= 1 AND aJobBuffer[0].eJobType = E_JobType.E_JobType_RemoveStone THEN 
				aJobBuffer[0].fStartPosX := stActJob.fDestPosX;
				aJobBuffer[0].fStartPosY := stActJob.fDestPosY;
				stActJob := aJobBuffer[0];
				
				eTargetPortalState := E_PortalState_New.eMoveToStone;
				ePortalState := E_PortalState_New.eDebug;
				fSetJobHeight := STONE_POS_FIELD_Z; 
				
				//ipNcCtrl.M_NewJob(stActJob.fStartPosX, stActJob.fStartPosY, STONE_POS_FIELD_Z);
				//ePortalState := E_PortalState_New.eMoveToStone;
			END_IF
		ELSE
			nStateJobSelect := M_SetJob_New();
			CASE nStateJobSelect OF
				-1: ePortalState := E_PortalState_New.eEStop;
				0: bReady := FALSE;
				1: bReady := TRUE;
					//Mehr als ein gleichzeitiger Auftrag (NewStone)
					IF nCntActiveJobs >= 1 AND aJobBuffer[0].eJobType = E_JobType.E_JobType_NewStone THEN		
						stActJob := aJobBuffer[0];
						//ipNcCtrl.M_NewJob(stActJob.fStartPosX, stActJob.fStartPosY, fStonePosZFromMag);
						//ePortalState := E_PortalState_New.eMoveToStone;
						fSetJobHeight := fStonePosZFromMag;
						eTargetPortalState := E_PortalState_New.eMoveToStone;
						ePortalState := E_PortalState_New.eDebug;
					//Mehr als ein gleichzeitiger Auftrag (RemoveStone)
					ELSIF nCntActiveJobs >= 1 AND aJobBuffer[0].eJobType = E_JobType.E_JobType_RemoveStone THEN
						stActJob := aJobBuffer[0];
						//ipNcCtrl.M_NewJob(stActJob.fStartPosX, stActJob.fStartPosY, STONE_POS_FIELD_Z);
						//ePortalState := e_PortalState_New.eMoveToStone;
						fSetJobHeight := STONE_POS_FIELD_Z;
						eTargetPortalState := E_PortalState_New.eMoveToStone;
						ePortalState := E_PortalState_New.eDebug;
					//Normaler MoveStone-Auftrag
					ELSIF nCntActiveJobs <= -1 THEN	
						stActJob := aJobBuffer[0];
						ipNcCtrl.M_NewJob(stActJob.fStartPosX, stActJob.fStartPosY, STONE_POS_FIELD_Z);
						ePortalState := E_PortalState_New.eMoveToStone;
					ELSE
						ipNcCtrl.M_NewJob(HMI.fPortalPosIdleX, HMI.fPortalPosIdleY, HMI.fPortalPosIdleZ);
						ePortalState := E_PortalState_New.eHome; //oder Error???
					END_IF
			END_CASE
		END_IF
			
	E_PortalState_New.eDebug:
		IF NOT ipNcCtrl.P_Busy THEN
			ipNcCtrl.M_NewJob(stActJob.fStartPosX, stActJob.fStartPosY, fSetJobHeight);
			ePortalState := eTargetPortalState;
		END_IF
	
	E_PortalState_New.eMoveToStone:
		IF NOT ipNcCtrl.P_Busy THEN 				//Warten bis Position erreicht
			IF ipNcCtrl.P_Error THEN				//Error
				fbError.M_Set(1, 'Achsenfehler', ePortalState, eID := ipNcCtrl.P_ErrID, eSrc := ipNcCtrl.P_ErrSrc);
				ePortalState := E_PortalState_New.eError;
			ELSE
				eTargetPortalState := E_PortalState_New.eTrspStone;
				ePortalState := E_PortalState_New.eCloseGripper;
			END_IF 
		END_IF
		
	E_PortalState_New.eCloseGripper:
		fbGripper(bEnable := TRUE, bClose := TRUE, bOpen := FALSE);
		IF NOT fbGripper.bBusy AND fbGripper.bGripperClosed THEN
			IF NOT fbGripper.fbError.bError THEN
				fbGripper(bClose := FALSE);
				IF fbGripper.bStoneInGripper THEN //Stein von Teilesensor erkannt
					IF stActJob.eJobType = E_JobType_NewStone THEN //Stein aus Magazin entnommen
						IF NOT bStampReset THEN
							aMagCounter[nSelectedMag] := aMagCounter[nSelectedMag] - 1;
						ELSE
							bStampReset := FALSE;
						END_IF
						ipNcCtrl.M_NewJob(stActJob.fDestPosX, stActJob.fDestPosY, STONE_POS_FIELD_Z); 
					ELSIF stActJob.eJobType = E_JobType.E_JobType_RemoveStone AND nCntActiveJobs > 1 AND aJobBuffer[1].fStartPosX <> 0 AND aJobBuffer[1].fStartPosY <> 0 THEN
						stActJob.fDestPosX := aJobBuffer[1].fStartPosX;
						stActJob.fDestPosY := aJobBuffer[1].fStartPosY;
						ipNcCtrl.M_NewJob(stActJob.fDestPosX, stActJob.fDestPosY, STONE_POS_FIELD_Z + STONE_HEIGHT);
					ELSIF (stActJob.eJobType = E_JobType.E_JobType_RemoveStone AND nCntActiveJobs = 1) OR (stActJob.eJobType = E_JobType.E_JobType_RemoveStone AND aJobBuffer[1].fStartPosX <> 0 AND aJobBuffer[1].fStartPosY <> 0) THEN
						stActJob.fDestPosX := STACK_POS_X;
						stActJob.fDestPosY := aMagYPositions[nSelectedMag];
						ipNcCtrl.M_NewJob(stActJob.fDestPosX, stActJob.fDestPosY, STACK_POS_Z_BASE_REMOVE + (nPosInMag-1)*STONE_HEIGHT);
					ELSIF stActJob.eJobType =  E_JobType.E_JobType_MoveStone THEN
						ipNcCtrl.M_NewJob(stActJob.fDestPosX, stActJob.fDestPosY, STONE_POS_FIELD_Z); 
					END_IF
					ePortalState := eTargetPortalState;					
				ELSE
					fbError.M_Set(1804, 'Keinen Stein gegriffen!', ePortalState, eID := E_ErrorIDs.eNoStoneInGripper, eSrc := E_ErrorSrcs.eGripper);
					fbGripper(bOpen := TRUE);
					IF aJobBuffer[0].nJobID = 0 THEN
						ePortalState := E_PortalState_New.eIdle;
					ELSE
						bReady := FALSE;
						ePortalState := E_PortalState_New.eSetJob;
					END_IF
				END_IF
			ELSE
				fbError := fbGripper.fbError;
				ePortalState := E_PortalState_New.eError;
			END_IF
		END_IF
	
	E_PortalState_New.eTrspStone:
		IF NOT ipNcCtrl.P_Busy THEN
			IF ipNcCtrl.P_Error THEN
				fbError.M_Set(1, 'Achsenfehler', ePortalState, eID := ipNcCtrl.P_ErrID, eSrc := ipNcCtrl.P_ErrSrc);
				ePortalState := E_PortalState_New.eError;
			ELSE
				ePortalState := E_PortalState_New.eOpenGripper;
			END_IF 
		END_IF
		
	E_PortalState_New.eError:
		// TODO: Was passiert hier???
	
	E_PortalState_New.eStampTriggered:
		IF NOT ipNcCtrl.P_Busy THEN 
			IF ipNcCtrl.P_Error THEN 	
				fbError.M_Set(1, 'Achsfehler', ePortalState, eID := ipNcCtrl.P_ErrID, eSrc := ipNcCtrl.P_ErrSrc);
				ePortalState := E_PortalState_New.eError;
			ELSE
				fbError.M_Set(1, 'Federung ausgelöst', ePortalState, eID := E_ErrorIDs.eStamp, eSrc := E_ErrorSrcs.ePortal);
				IF aJobBuffer[0].nJobID <> 0 AND aJobBuffer[0].eJobType = E_JobType.E_JobType_RemoveStone THEN
					ePortalState := E_PortalState_New.eSetJob;
				ELSIF aJobBuffer[0].nJobID = 0 THEN
					ePortalState := E_PortalState_New.eIdle;
				ELSIF aJobBuffer[0].nJobID <> 0 AND aJobBuffer[0].eJobType = E_JobType.E_JobType_MoveStone THEN
					ipNcCtrl.M_NewJob(fTargetPosX := aAxis[X].NcToPlc.ActPos, fTargetPosY := aAxis[Y].NcToPlc.ActPos, fTargetPosZ := aAxis[Z].NcToPlc.ActPos+ 10);
					eTargetPortalState := E_PortalState_New.eTrspStone;
				ELSIF aJobBuffer[0].nJobID <> 0 AND aJobBuffer[0].eJobType = E_JobType.E_JobType_NewStone THEN
					ePortalState := E_PortalState_New.eSetJob; //TODO: testen?
				END_IF
			END_IF 
		ELSE
			ipNcCtrl.M_CancleJob();
		END_IF
		
	E_PortalState_New.eHome:
		IF NOT ipNcCtrl.P_Busy THEN
			IF ipNcCtrl.P_Error THEN
				fbError.M_Set(1, 'Achsenfehler', ePortalState, eID := ipNcCtrl.P_ErrID, eSrc := ipNcCtrl.P_ErrSrc);
				ePortalState := E_PortalState_New.eError;
			ELSE
				fbAxesEnable.M_DisableAxes();
				ePortalState := E_PortalState_New.eIdle;
			END_IF 
		END_IF
		
	E_PortalState_New.eManualMode:
		A_CollsionAvoidance();
		fbGripper(bEnable := TRUE, bClose := HMI.bCloseGripper, bOpen := HMI.bOpenGripper);
		IF NOT bManualMode THEN
			fbGripper(bEnable := TRUE, bClose := FALSE, bOpen := FALSE);
			fbAxesEnable.M_EnableAxes();
			ipNcCtrl.P_Enable := TRUE;
			IF fbAxesEnable.bAllAxesReady THEN
				ipNcCtrl.M_NewJob(HMI.fPortalPosIdleX, HMI.fPortalPosIdleY, HMI.fPortalPosIdleZ); //Auftrag an Achsen geben: Grundposition anfahren
				ePortalState := E_PortalState_New.eHome;
			END_IF
		END_IF
		
	E_PortalState_New.eEStop:		
		IF NOT ipNcCtrl.P_Busy THEN
			//ipNcCtrl.M_CancleJob();	//TODO: neu testen
			fbAxesEnable.M_DisableAxes();
		END_IF
		IF bSafetyOK THEN
			IF fbError.bError THEN
				ePortalState := E_PortalState_New.eError;
			ELSE
				bCheck := FALSE;
				bCheckedAllMag := FALSE;
				eCheckMagState := E_CheckMagazines_New.eIdle;
				eSetJobState := E_SetJobState.eIdle;;
				nStonesInMag := MAGAZINE_CAPACITY;
				IF M_IsHomed() THEN
					ePortalState := E_PortalState_New.eIdle;
					nCntActiveJobs := 0;		//TODO: Werte hier notwendig/richtig?
					nCntRemoveStones := 0;
					HMI.bAllJobsSend := FALSE;
				ELSE
					ePortalState := E_PortalState_New.eAfterEStop;
					fbAxesEnable.M_EnableAxes();
				END_IF
			END_IF
		END_IF
		
	E_PortalState_New.eAfterEStop:
		fbGripper();
		IF ipNcCtrl.P_ReadyForJob THEN
			nCntActiveJobs := 0;
			nCntRemoveStones := 0;
			eSetJobState := E_SetJobState.eIdle;
			HMI.bAllJobsSend := FALSE;
			IF fbGripper.bGripperClosed AND fbGripper.bStoneInGripper THEN
				stActJob.nJobID := 1;
				stActJob.eJobType := E_JobType_RemoveStone;
				stActJob.bBlack := bLastJobBlack;
				ipNcCtrl.M_NewJob(aAxis[0].NcToPlc.ActPos, aAxis[1].NcToPlc.ActPos, GVL_CONST.STONE_POS_FIELD_Z);
				ePortalState := E_PortalState_New.eTrspStone;
	//TODO: auswählen Stein(e) zurücktransportieren??? Bleibt hier sonst stecken
			ELSE
				ipNcCtrl.M_NewJob(HMI.fPortalPosIdleX, HMI.fPortalPosIdleY, HMI.fPortalPosIdleZ); //Auftrag an Achsen geben: Grundposition anfahren
				ePortalState := E_PortalState_New.eHome;
			END_IF
		END_IF
END_CASE
]]></ST>
    </Implementation>
    <Action Name="A_ClearJobBuffer" Id="{3aaaa407-45d5-435f-9470-9ca991bcc4a7}">
      <Implementation>
        <ST><![CDATA[MEMSET(ADR(aJobBuffer), 0, SIZEOF(aJobBuffer));
MEMSET(ADR(stActJob), 0, SIZEOF(stActJob));
nJobCount := 0;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_CollsionAvoidance" Id="{c11f6b99-8591-41b6-b107-11d5d9be8a39}">
      <Implementation>
        <ST><![CDATA[IF aAxis[X].NcToPlc.SetPos < 0 AND aAxis[Z].NcToPlc.SetPos < MIN_MOVE_HEIGHT_Z THEN
	fbAxesEnable.fOverride := HMI.fAxesOverrideMan;
	fbAxesEnable.bEnableXY := FALSE;//erst beide disablen
	fbAxesEnable.bEnableZn := FALSE;
	FOR nMag := 0 TO MAGAZINE_NUMBER - 1 DO
		fbAxesEnable.bEnableZn := fbAxesEnable.bEnableZn OR ABS(aAxis[Y].NcToPlc.SetPos - aMagYPositions[nMag]) < 0.5; //muss über einem der Stapel stehen (Y)
	END_FOR
	fbAxesEnable.bEnableZn := fbAxesEnable.bEnableZn AND ABS(aAxis[X].NcToPlc.SetPos - STACK_POS_X) < 0.5; //muss die X-Position der Stapel haben
	fbAxesEnable.bEnableZn := fbAxesEnable.bEnableZn AND aAxis[Z].NcToPlc.SetPos > 2.4; //Z darf nicht den Boden der Magazine berühren
	IF fbAxesEnable.bEnableZn = FALSE THEN
		FOR nMag := 0 TO MAGAZINE_NUMBER - 1 DO
			fbAxesEnable.bEnableZn := fbAxesEnable.bEnableZn OR ABS(aAxis[Y].NcToPlc.SetPos - aMagYScanPositions[nMag]) < 0.5; //muss über einem der Stapel stehen (Y)
		END_FOR
		fbAxesEnable.bEnableZn := fbAxesEnable.bEnableZn AND ABS(aAxis[X].NcToPlc.SetPos - STACK_SCAN_POS_X) < 0.5; //muss die X-Position der Stapel haben
	END_IF
	fbAxesEnable.bEnableZn := fbAxesEnable.bEnableZn AND NOT fbGripper.bPartSensor;
ELSE
	fbAxesEnable.fOverride := HMI.fAxesOverride;
	IF aAxis[Z].NcToPlc.SetPos > STONE_POS_FIELD_Z + STONE_HEIGHT THEN
		fbAxesEnable.bEnableXY := TRUE;
	ELSE
		fbAxesEnable.bEnableXY := FALSE;
	END_IF
	fbAxesEnable.bEnableZn := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Cycle" Id="{fc8d1b1e-6698-48fa-b19e-ac2c5b727307}">
      <Implementation>
        <ST><![CDATA[fbAxesEnable(stX := aAxis[X], stY := aAxis[Y], stZ := aAxis[Z]);
rTrigStamp(CLK := bStampZAxis);
rTrigCheck(CLK := fbGripper.bPartSensor);

bSafetyErrAck := FALSE;
bQuitEStop := FALSE;

(*SAFETY CHECK*)
IF NOT bSafetyOK AND ePortalState <> E_PortalState_New.eEStop THEN
	fbGripper(bEnable := FALSE, bClose := FALSE, bOpen := FALSE); //Stopp Greifer
	IF ipNcCtrl <> 0 THEN
		ipNcCtrl.P_Enable := FALSE; //Stopp Achsen
	END_IF
	bLastJobBlack := stActJob.bBlack;
	ePortalState := E_PortalState_New.eEStop;
END_IF

IF ipNcCtrl <> 0 THEN
	ipNcCtrl.M_AxisRef(rX := aAxis[X], rY := aAxis[Y], rZ := aAxis[Z]);
	ipNcCtrl.P_bInductiveSensor := fbGripper.bPartSensor;
	ipNcCtrl.M_Cyclic();
END_IF

(*CHECK FOR NEW JOB*)
IF stNewJob.nJobID > 0 AND HMI.bSetJob AND stNewJob.nJobID <> stActJob.nJobID THEN
	IF nJobCount < MAX_JOB_COUNT AND 
		(stNewJob.fStartPosX > 0 AND stNewJob.fStartPosY > 0 OR stNewJob.eJobType = E_JobType_NewStone) AND //Start Pos must be on the display (if not newStone)
		(stNewJob.fDestPosX > 0 AND stNewJob.fDestPosY > 0 OR stNewJob.eJobType = E_JobType_RemoveStone) //End Pos must be on the display (if not removeStone)
	THEN
		IF nJobCount > 0 THEN
			FOR i := 0 TO nJobCount - 1 DO
				IF stNewJob.nJobID = aJobBuffer[i].nJobID THEN
					EXIT;
				END_IF
			END_FOR
			IF i = nJobCount THEN
				aJobBuffer[nJobCount] := stNewJob;
				aJobBuffer[nJobCount].fStartPosX := aJobBuffer[nJobCount].fStartPosX + HMI.fScreenPosOffsetX;
				aJobBuffer[nJobCount].fStartPosY := aJobBuffer[nJobCount].fStartPosY + HMI.fScreenPosOffsetY;
				aJobBuffer[nJobCount].fDestPosX := aJobBuffer[nJobCount].fDestPosX + HMI.fScreenPosOffsetX;
				aJobBuffer[nJobCount].fDestPosY := aJobBuffer[nJobCount].fDestPosY + HMI.fScreenPosOffsetY;
				nJobCount := nJobCount + 1;
			END_IF
		ELSIF nJobCount = 0 THEN
			aJobBuffer[nJobCount] := stNewJob;
			aJobBuffer[nJobCount].fStartPosX := aJobBuffer[nJobCount].fStartPosX + HMI.fScreenPosOffsetX;
			aJobBuffer[nJobCount].fStartPosY := aJobBuffer[nJobCount].fStartPosY + HMI.fScreenPosOffsetY;
			aJobBuffer[nJobCount].fDestPosX := aJobBuffer[nJobCount].fDestPosX + HMI.fScreenPosOffsetX;
			aJobBuffer[nJobCount].fDestPosY := aJobBuffer[nJobCount].fDestPosY + HMI.fScreenPosOffsetY;
			nJobCount := nJobCount + 1;
		END_IF
		HMI.bSetJob := FALSE;
	ELSE
		;//MELDUNG: Kein Platz mehr im Job Buffer
	END_IF
END_IF

fbRTrigSafety(CLK := bSafetyOK);
IF fbRTrigSafety.Q THEN
	FOR i := 0 TO MAGAZINE_NUMBER - 1 DO
		aMagSkipCheck[i] := FALSE;
	END_FOR
	A_ClearJobBuffer();
	IF ipNcCtrl <> 0 THEN
		ipNcCtrl.P_Enable := TRUE;
	END_IF
	bQuit := TRUE;
END_IF

IF ipNcCtrl.P_Error AND ipNcCtrl.P_ErrID = E_ErrorIDs.eNotAllowedDriveDown THEN
	ePortalState := E_PortalState_New.eError;
END_IF

(*RESET/ERROR ACK*)
IF bQuit THEN
	bQuit := FALSE;
	fbAxesEnable.bReset := TRUE;
	bValidateStonePos := FALSE;
	IF fbError.bError THEN
		A_ClearJobBuffer();
		FOR i := 0 TO MAGAZINE_NUMBER - 1 DO
			aMagSkipCheck[i] := FALSE;
		END_FOR
		IF ePortalState = E_PortalState_New.eError THEN
			ePortalState := E_PortalState_New.eAfterEStop;
			fbAxesEnable.M_EnableAxes();
		END_IF
	END_IF
	fbError.M_Reset();
	fbGripper.fbError.M_Reset();
	
	bSafetyErrAck := TRUE;
	bQuitEStop := TRUE;
	
	FOR i := X TO Z DO
		aAxis[i].ReadStatus();
		IF aAxis[i].Status.Error THEN
			fbResetAxis(Axis := aAxis[i], Execute := TRUE);
			fbResetAxis(Axis := aAxis[i], Execute := FALSE);
		END_IF
	END_FOR
	
	IF ipNcCtrl <> 0 THEN
		ipNcCtrl.P_Reset := TRUE;
	END_IF
END_IF

(*SET BUSY*)
bBusy := ePortalState <> E_PortalState_New.eIdle 
	 AND ePortalState <> E_PortalState_New.eError
	 AND ePortalState <> E_PortalState_New.eEStop;
	 
IF rTrigStamp.Q THEN
	IF ipNcCtrl <> 0 THEN
		IF ipNcCtrl.P_Busy THEN
			ipNcCtrl.M_CancleJob();
			ipNcCtrl.M_NewJob(HMI.fPortalPosIdleX, HMI.fPortalPosIdleY, HMI.fPortalPosIdleZ); //Auftrag an Achsen geben: Grundposition anfahren
			ePortalState := E_PortalState_New.eStampTriggered;
		ELSE
			ePortalState := E_PortalState_New.eStampTriggered;
		END_IF
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_DequeueJob" Id="{23753d75-2743-4a21-8ea1-4e155a5d105d}">
      <Implementation>
        <ST><![CDATA[IF nJobCount > 0 THEN
	IF nJobCount > 1 THEN
		FOR k := 0 TO nJobCount - 2 DO
			MEMCPY(ADR(aJobBuffer[k]), ADR(aJobBuffer[k + 1]), SIZEOF(aJobBuffer[k]));
		END_FOR
	END_IF
	MEMSET(ADR(aJobBuffer[nJobCount - 1]), 0, SIZEOF(aJobBuffer[nJobCount - 1]));
	nJobCount := nJobCount - 1;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Init" Id="{46aece40-4833-4cfc-a9cc-acace2fd4a2a}">
      <Implementation>
        <ST><![CDATA[(*SET INTERFACE*)
ipNcCtrl := fbNciCtrl;

//Fill Arrays	
aMagCounter[0] := MAGAZINE_CAPACITY;
aMagCounter[1] := MAGAZINE_CAPACITY;
aMagCounter[2] := MAGAZINE_CAPACITY;
aMagCounter[3] := MAGAZINE_CAPACITY;
aMagCounter[4] := MAGAZINE_CAPACITY;
aMagCounter[5] := MAGAZINE_CAPACITY;

aMagYPositions[0] := STACK_1_POS_Y;
aMagYPositions[1] := STACK_2_POS_Y;
aMagYPositions[2] := STACK_3_POS_Y;
aMagYPositions[3] := STACK_4_POS_Y;
aMagYPositions[4] := STACK_5_POS_Y;
aMagYPositions[5] := STACK_6_POS_Y;
    
aMagYScanPositions[0] := STACK_1_SCAN_POS_Y;
aMagYScanPositions[1] := STACK_2_SCAN_POS_Y;
aMagYScanPositions[2] := STACK_3_SCAN_POS_Y;
aMagYScanPositions[3] := STACK_4_SCAN_POS_Y;
aMagYScanPositions[4] := STACK_5_SCAN_POS_Y;
aMagYScanPositions[5] := STACK_6_SCAN_POS_Y;

]]></ST>
      </Implementation>
    </Action>
    <Method Name="M_CheckStoneInMag_New" Id="{71713fb2-3d91-47aa-8ed9-c1fab8497a39}">
      <Declaration><![CDATA[METHOD M_CheckStoneInMag_New : INT  //0: working; -2: Error; >0 Anzahl Steine in Magazin; -1: keine Steine in Magazin gefunden
VAR_INPUT
	nMagNumber		: INT;
	nPosNumber		: INT;
	

END_VAR
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Anzahl an Magazinen stimmt nicht überein
IF MAGAZINE_NUMBER <> 6 THEN
	fbError.M_Set(1,'Anzahl festgelegter Magazine falsch!', eCheckMagState, eID := E_ErrorIDs.eInvalidData, eSrc := E_ErrorSrcs.ePlc);
	M_CheckStoneInMag_New := -2;
	RETURN;
END_IF

//Übergebene Steinposition in Magazin ungültig
IF nPosNumber < 1 OR nPosNumber > MAGAZINE_CAPACITY THEN
	fbError.M_Set(1,'Übergebene Steinposition ungültig!', eCheckMagState, eID := E_ErrorIDs.eInvalidData, eSrc := E_ErrorSrcs.ePlc);
	M_CheckStoneInMag_New := -2;
	RETURN;
END_IF

//Übergebene Magazinnummer ungültig
IF nMagNumber <  0 OR nMagNumber >= MAGAZINE_NUMBER THEN
	fbError.M_Set(1,'Übergebene Magazin-Nummer ungültig!', eCheckMagState, eID := E_ErrorIDs.eInvalidData, eSrc := E_ErrorSrcs.ePlc);
	M_CheckStoneInMag_New := -2;
	RETURN;
END_IF

//Gefordertes Magazin muss nicht überprüft werden
IF aMagSkipCheck[nMagNumber] THEN
	IF aMagCounter[nMagNumber] = 0 THEN
		M_CheckStoneInMag_New := -3;
	ELSE
		M_CheckStoneInMag_New := aMagCounter[nMagNumber];
	END_IF
	RETURN;
END_IF

//Steinanzahl im Magazin zu hoch 
IF 
	fbGripper.bPartSensor 
	AND aAxis[Z].NcToPlc.SetPos > STONE_HEIGHT * (MAGAZINE_CAPACITY - 1) + STACK_SCAN_POS_Z_BASE + STONE_HEIGHT*0.8
	AND aAxis[Z].NcToPlc.SetVelo < 0 //abwärtsbewegung
THEN
	fbError.M_Set(1,'Zu viele Steine in Magazin!', ePortalState, eID := E_ErrorIDs.eInvalidData, eSrc := E_ErrorSrcs.ePortal);
	ipNcCtrl.M_CancleJob();
	M_CheckStoneInMag_New := -2;
END_IF


//Suche nach Anzahl Steine im Magazin
CASE eCheckMagState OF 
	E_CheckMagazines_New.eIdle:
		nStonesInMagazin := 4;
		eCheckMagState := E_CheckMagazines_New.eStartNewNCI;
	
	E_CheckMagazines_New.eStartNewNCI:
		ipNcCtrl.M_NewJob(STACK_SCAN_POS_X, aMagYScanPositions[nMagNumber], STACK_POS_Z_BASE + ((nStonesInMagazin-1) * STONE_HEIGHT ));	
		eCheckMagState := E_CheckMagazines_New.eDebug;
		
	E_CheckMagazines_New.eDebug: 
		IF ipNcCtrl.P_Busy THEN
			eCheckMagState := E_CheckMagazines_New.eWaitForPortal;
		END_IF
		
	E_CheckMagazines_New.eWaitForPortal:
		IF rTrigCheck.Q THEN						//Stein gefunden
			aMagCounter[nMagNumber] := nStonesInMagazin;
			M_CheckStoneInMag_New := nStonesInMagazin;
		ELSIF NOT ipNcCtrl.P_Busy AND NOT fbGripper.bPartSensor THEN					
			IF nStonesInMagazin > 1 THEN					//an aktueller Position kein Stein gefunden
				nStonesInMagazin := nStonesInMagazin -1;
				eCheckMagState:= E_CheckMagazines_New.eStartNewNCI;
			ELSE											//gar kein Stein im Magazin gefunden
				aMagCounter[nMagNumber] := 0;
				M_CheckStoneInMag_New := -1;
			END_IF
		END_IF
END_CASE

IF M_CheckStoneInMag_New <> 0 THEN
	aMagSkipCheck[nMagNumber] := TRUE;
	eCheckMagState := E_CheckMagazines_New.eIdle;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsHomed" Id="{02510008-ce5d-4f33-ad8f-a1a97d1ea3c0}">
      <Declaration><![CDATA[METHOD M_IsHomed : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_IsHomed := ABS(aAxis[X].NcToPlc.SetPos - HMI.fPortalPosIdleX) < 2
		AND ABS(aAxis[Y].NcToPlc.SetPos - HMI.fPortalPosIdleY) < 2
		AND ABS(aAxis[Z].NcToPlc.SetPos - HMI.fPortalPosIdleZ) < 2;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SelEmptyPos_New" Id="{b9c507bf-5fcb-4a6c-b88a-0a3383bdd494}">
      <Declaration><![CDATA[METHOD M_SelEmptyPos_New : BOOL
VAR_INPUT
END_VAR
VAR
	bFirstJobBlack : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF aJobBuffer[0].nJobID <> 0 AND aJobBuffer[0].bBlack THEN		//First Job Black or white
	bFirstJobBlack := TRUE;
ELSIF 
	aJobBuffer[0].nJobID <> 0 AND NOT aJobBuffer[0].bBlack THEN
	bFirstJobBlack := FALSE;
END_IF

FOR i := 0 TO (MIN(4,nJobCount) - 1) BY 1 DO		//Suche Anzahl an zum 1. Job gleichfarbigen Job bis max. 4 Jobs
	IF aJobBuffer[i].nJobID <> 0 AND aJobBuffer[i].bBlack = bFirstJobBlack AND aJobBuffer[i].eJobType = E_JobType.E_JobType_RemoveStone THEN
		nCntActiveJobs := nCntActiveJobs + 1;
	ELSE
		EXIT;
	END_IF
END_FOR

WHILE(nCntActiveJobs > 0) DO
	FOR i := SEL(bFirstJobBlack, MAGAZINE_NUMBER/2, 0) TO SEL (bFirstJobBlack, MAGAZINE_NUMBER-1, MAGAZINE_NUMBER/2-1) BY 1 DO //SEL: Entscheide ob schwarze oder weiße Magazine
		IF MAGAZINE_CAPACITY - aMagCounter[i] >= nCntActiveJobs THEN	//genügend freie Plätze in Magazin vorhanden?
			nSelectedMag := i;
			nPosInMag := aMagCounter[i] + 1;	//abzulegende unterste Steinposition (1 ganz unten, 4 ganz oben)
			fStonePosZFromMag := STACK_POS_Z_BASE + STONE_HEIGHT * (nPosInMag - 1);
			nCntRemoveStones := nCntActiveJobs;
			M_SelEmptyPos_New := TRUE;
			EXIT;
		END_IF
	END_FOR
	
	IF M_SelEmptyPos_New THEN
		EXIT;
	END_IF
	IF NOT M_SelEmptyPos_New AND nCntActiveJobs >= 1 THEN
		i := SEL(bFirstJobBlack, MAGAZINE_NUMBER/2, 0);
		nCntActiveJobs := nCntActiveJobs - 1;
	ELSIF NOT M_SelEmptyPos_New AND nCntActiveJobs = 0 THEN
		M_SelEmptyPos_New := FALSE;
		EXIT;
	END_IF
END_WHILE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SelNewStone_New" Id="{441b417a-b09c-4911-a1e2-0d4af26651d8}">
      <Declaration><![CDATA[METHOD M_SelNewStone_New : BOOL
VAR_INPUT
END_VAR
VAR
	i		: INT;
	j 		: INT;
	bFirstJobBlack	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF aJobBuffer[0].nJobID <> 0 AND aJobBuffer[0].bBlack THEN		//First Job Black or white
	bFirstJobBlack := TRUE;
ELSIF 
	aJobBuffer[0].nJobID <> 0 AND NOT aJobBuffer[0].bBlack THEN
	bFirstJobBlack := FALSE;
END_IF

FOR i := 0 TO (MIN(4,nJobCount) - 1) BY 1 DO		//Suche Anzahl an zum 1. Job gleichfarbigen Job bis max. 4 Jobs
	IF aJobBuffer[i].nJobID <> 0 AND aJobBuffer[i].bBlack = bFirstJobBlack AND aJobBuffer[i].eJobType = E_JobType.E_JobType_NewStone THEN
		nCntActiveJobs := nCntActiveJobs + 1;
	ELSE
		EXIT;
	END_IF
END_FOR

WHILE(nCntActiveJobs > 0) DO
	FOR i := SEL(bFirstJobBlack, MAGAZINE_NUMBER/2, 0) TO SEL (bFirstJobBlack, MAGAZINE_NUMBER-1, MAGAZINE_NUMBER/2-1) BY 1 DO //SEL: Entscheide ob schwarze oder weiße Magazine
		IF aMagCounter[i] >= nCntActiveJobs THEN	//genügend Steine in einem Magazin vorhanden
			nSelectedMag := i;
			nPosInMag := aMagCounter[i] - nCntActiveJobs + 1;	//zu greifenden Stein (1 ganz unten, 4 ganz oben)
			aJobBuffer[0].fStartPosX := STACK_POS_X;
			aJobBuffer[0].fStartPosY := aMagYPositions[nSelectedMag];
			fStonePosZFromMag := STACK_POS_Z_BASE + STONE_HEIGHT * (nPosInMag - 1);
			M_SelNewStone_New := TRUE;
			EXIT;
		END_IF
	END_FOR
	IF M_SelNewStone_New THEN
		EXIT;
	END_IF
	IF NOT M_SelNewStone_New AND nCntActiveJobs >= 1 THEN
		i := SEL(bFirstJobBlack, MAGAZINE_NUMBER/2, 0);
		nCntActiveJobs := nCntActiveJobs - 1;
	ELSIF NOT M_SelNewStone_New AND nCntActiveJobs = 0 THEN
		//Gar keine Steine gefunden --> TODO: Was jetzt machen???
		M_SelNewStone_New := FALSE;
		EXIT;
	END_IF
END_WHILE





]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SetJob_New" Id="{d6338665-33b7-4f61-acdd-711e479e637f}">
      <Declaration><![CDATA[METHOD M_SetJob_New : INT
VAR_INPUT
END_VAR
VAR
	bTest	: BOOL;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eSetJobState OF 	//TODO: wenn erste mal Fehler bei M_Sel, dann alle aMagSkipCHeck zurücksetzen und neu suchen
	E_SetJobState.eIdle: 
		IF nJobCount > 0 AND aJobBuffer[0].eJobType = E_JobType_MoveStone AND aJobBuffer[0].nJobID <> 0 THEN
			nCntActiveJobs := -1;
			M_SetJob_New := 1;
		ELSIF nJobCount > 0 AND aJobBuffer[0].eJobType = E_JobType_NewStone AND aJobBuffer[0].nJobID <> 0 THEN
			eSetJobState := E_SetJobState.eSelNewStone;
			nCntActiveJobs := 0;
		ELSIF nJobCount > 0 AND aJobBuffer[0].eJobType = E_JobType.E_JobType_RemoveStone AND aJobBuffer[0].nJobID <> 0 THEN
			//IF NOT bCheckedAllMag THEN
			//	FOR i := 0 TO MAGAZINE_NUMBER -1 BY 1 DO
			//		aMagSkipCheck[i] := FALSE;
			//	END_FOR
			//	eSetJobState := E_SetJobState.eCheckAllMagazines;
			//ELSE
			//	eSetJobState := E_SetJobState.eSelRemoveStone;
			//END_IF
			eSetJobState := E_SetJobState.eSelRemoveStone;
			
			nCntActiveJobs := 0;
		ELSIF aJobBuffer[0].nJobID = 0 THEN
			fbError.M_Set(1,'In M_SetJob Auftrag erwartet, aber nicht gefunden!', ePortalState, eID := E_ErrorIDs.eNoJobsFound, eSrc := E_ErrorSrcs.ePortal);
			M_SetJob_New := -1;
		END_IF
		
		nValidationValue := 0;
		nNumChecked := 0;
		
	E_SetJobState.eSelNewStone:
		IF M_SelNewStone_New() THEN
			eSetJobState := E_SetJobState.eValidateNewStone;
		ELSE
			IF bCheckedAllMag THEN
				M_SetJob_New := -1;																	
				fbError.M_Set(1,'Neuer Stein aufnehmen: Keine Steine im Steinlager gefunden!', ePortalState, eID := E_ErrorIDs.eNoStonesFound, eSrc := E_ErrorSrcs.ePortal);
				eSetJobState := E_SetJobState.eIdle;
			ELSE
				FOR i := 0 TO MAGAZINE_NUMBER -1 BY 1 DO
					aMagSkipCheck[i] := FALSE;
				END_FOR
				eSetJobState := E_SetJobState.eCheckAllMagazines;
			END_IF
		END_IF
		
	E_SetJobState.eValidateNewStone:
		nValidationValue := M_CheckStoneInMag_New(nMagNumber := nSelectedMag, nPosNumber := nPosInMag);
		IF nValidationValue = -2 THEN																	//direkter Fehler
			eSetJobState := E_SetJobState.eIdle;
			M_SetJob_New := -1;
		ELSIF nValidationValue > 0 AND nValidationValue-nCntActiveJobs+1 = nPosInMag THEN				//Gefundenes Magazin korrekt
			eSetJobState := E_SetJobState.eIdle;
			M_SetJob_New := 1;
		ELSIF nValidationValue = -1 OR (nValidationValue > 0 AND nValidationValue <> nPosInMag) OR nValidationValue = -3 THEN 
			//TODO TESTEN: ?? kein Stein in Magazin gefunden oder Anzahl stimmen nicht überein??
			//--> Problem Endlos-Schleife?
			IF bCheckedAllMag THEN 
				M_SetJob_New := -1;
				fbError.M_Set(1,'Beim Aufbauen kein Stein in Magazin gefunden!', ePortalState, eID := E_ErrorIDs.eNoStonesFound, eSrc := E_ErrorSrcs.ePortal);
				eSetJobState := E_SetJobState.eIdle;
			ELSE
				FOR i := 0 TO MAGAZINE_NUMBER -1 BY 1 DO
					aMagSkipCheck[i] := FALSE;
				END_FOR
				eSetJobState := E_SetJobState.eCheckAllMagazines;
			END_IF
		END_IF
		
		IF nValidationValue <> 0 AND eSetJobState <> E_SetJobState.eCheckAllMagazines THEN
			eSetJobState := E_SetJobState.eIdle;
		END_IF
		
	E_SetJobState.eSelRemoveStone:
		IF M_SelEmptyPos_New() THEN
			eSetJobState := E_SetJobState.eValidateRemoveStone;
		ELSE
			IF bCheckedAllMag THEN 
				M_SetJob_New := -1;
				fbError.M_Set(1,'Beim Abräumen keine freien Steinlager gefunden!', ePortalState, eID := E_ErrorIDs.eClearFieldNoCapacityFound, eSrc := E_ErrorSrcs.ePortal);
				eSetJobState := E_SetJobState.eIdle;
			ELSE
				FOR i := 0 TO MAGAZINE_NUMBER -1 BY 1 DO
					aMagSkipCheck[i] := FALSE;
				END_FOR
				eSetJobState := E_SetJobState.eCheckAllMagazines;
			END_IF
		END_IF
		
	E_SetJobState.eValidateRemoveStone:
		nValidationValue := M_CheckStoneInMag_New(nMagNumber := nSelectedMag, nPosNumber := nPosInMag);
		IF nValidationValue = -2 THEN	
			M_SetJob_New := -1;
		ELSIF nValidationValue > 0 AND nValidationValue + 1 = nPosInMag THEN	//Gefundenes Magazin korrekt mit bis zu drei Steinen Platz
			M_SetJob_New := 1;
		ELSIF nValidationValue = -3 AND nValidationValue + 4 = nPosInMag THEN	//Überprüfung geskippt,  mit 4 Steinen Platz
			M_SetJob_New := 1;
		ELSIF nValidationValue = -1 THEN										//Gefundenes Magazin korrekt mit 4 Steinen Platz
			nPosInMag := 1;
			fStonePosZFromMag := STACK_POS_Z_BASE;
			M_SetJob_New := 1;
		ELSIF nValidationValue = 0 THEN
			bTest := TRUE;
		ELSE //TESTEN: Anzahl stimmen nicht überein--> TODO: jetzt M_SelNewStone_New() neu durchlaufen lassen, nMag[] ist schon in Methode auf 0 gesetzt
			IF bCheckedAllMag THEN
				M_SetJob_New := -1;
				fbError.M_Set(1,'Beim Abräumen keine freien Steinlager gefunden!', ePortalState, eID := E_ErrorIDs.eClearFieldNoCapacityFound, eSrc := E_ErrorSrcs.ePortal);
				eSetJobState := E_SetJobState.eIdle;
			ELSE
				eSetJobState := E_SetJobState.eSelRemoveStone;
			END_IF
		END_IF
		
		IF nValidationValue <> 0 AND eSetJobState <> E_SetJobState.eSelRemoveStone THEN
			eSetJobState := E_SetJobState.eIdle;
		END_IF
		
	E_SetJobState.eCheckAllMagazines:
		IF aMagSkipCheck[nNumChecked] THEN
			nNumChecked := nNumChecked + 1;
		ELSE
			nValidationValue := M_CheckStoneInMag_New(nMagNumber := nNumChecked, nPosNumber := 1);
		END_IF
		IF nValidationValue >= 1 OR nValidationValue = -1 OR nValidationValue = -3 THEN
			IF nNumChecked = MAGAZINE_NUMBER-1 THEN
				bCheckedAllMag := TRUE;
				nNumChecked := 0;
				IF nJobCount > 0 AND aJobBuffer[0].eJobType = E_JobType.E_JobType_RemoveStone AND aJobBuffer[0].nJobID <> 0 THEN
					eSetJobState := E_SetJobState.eSelRemoveStone;
				ELSIF nJobCount > 0 AND aJobBuffer[0].eJobType = E_JobType_NewStone AND aJobBuffer[0].nJobID <> 0 THEN
					eSetJobState := E_SetJobState.eSelNewStone;
				END_IF
			ELSE
				nValidationValue := 0;
				nNumChecked := nNumChecked + 1;
			END_IF
		END_IF
	
	E_SetJobState.eAxesNotReady:
		IF fbAxesEnable.bAllAxesReady THEN
			eSetJobState := E_SetJobState.eIdle;
		END_IF
END_CASE

IF NOT fbAxesEnable.bAllAxesReady THEN
	eSetJobState := E_SetJobState.eAxesNotReady;
END_IF
]]></ST>
      </Implementation>
    </Method>
