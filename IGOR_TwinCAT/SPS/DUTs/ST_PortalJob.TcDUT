	eJobType:		E_JobType;  //Neuer Stein von Stapel oder Stein auf Brett oder Stein entfernen
	fStartPosX:		LREAL; //Startposition x in mm
	fStartPosY:		LREAL; //Startposition y in mm
	fDestPosX:		LREAL; //Zielposition x in mm
	fDestPosY:		LREAL; //Zielposition y in mm
